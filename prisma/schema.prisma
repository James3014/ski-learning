generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SeatStatus {
  pending
  invited
  claimed
  completed
  expired
}

enum SeatIdentityStatus {
  draft
  submitted
  confirmed
}

enum SportType {
  snowboard
  ski
}

model Resort {
  id       Int      @id @default(autoincrement())
  name     String
  location String
  lessons  Lesson[]
  studentMappings StudentMapping[]
}

model Instructor {
  id                     String   @id @default(uuid())
  accountId              String   @map("account_id")
  canViewSharedRecords   Boolean  @default(false) @map("can_view_shared_records")
  lessons                Lesson[]
}

model Lesson {
  id           Int      @id @default(autoincrement())
  resortId     Int      @map("resort_id")
  instructorId String   @map("instructor_id")
  date         DateTime @db.Date
  
  resort       Resort      @relation(fields: [resortId], references: [id])
  instructor   Instructor  @relation(fields: [instructorId], references: [id])
  seats        OrderSeat[]
}

model OrderSeat {
  id                String     @id @default(uuid())
  lessonId          Int        @map("lesson_id")
  seatNumber        Int        @map("seat_number")
  claimedMappingId  String?    @map("claimed_mapping_id")
  status            SeatStatus @default(pending)
  claimedAt         DateTime?  @map("claimed_at") @db.Timestamptz
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  
  lesson            Lesson              @relation(fields: [lessonId], references: [id])
  claimedMapping    StudentMapping?     @relation(fields: [claimedMappingId], references: [id])
  invitation        SeatInvitation?
  identityForm      SeatIdentityForm?
  
  @@map("order_seats")
}

model SeatInvitation {
  code       String    @id
  seatId     String    @unique @map("seat_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz
  claimedBy  String?   @map("claimed_by")
  
  seat       OrderSeat @relation(fields: [seatId], references: [id])
  
  @@map("seat_invitations")
}

model GlobalStudent {
  id                    String                  @id @default(uuid())
  email                 String
  phone                 String
  birthDate             DateTime                @map("birth_date") @db.Date
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz
  
  mappings              StudentMapping[]
  guardianRelationships GuardianRelationship[]
  
  @@map("global_students")
}

model StudentMapping {
  id               String      @id @default(uuid())
  globalStudentId  String      @map("global_student_id")
  resortId         Int         @map("resort_id")
  
  globalStudent    GlobalStudent @relation(fields: [globalStudentId], references: [id])
  resort           Resort        @relation(fields: [resortId], references: [id])
  claimedSeats     OrderSeat[]
  
  @@map("student_mappings")
}

model GuardianRelationship {
  id               String        @id @default(uuid())
  guardianEmail    String        @map("guardian_email")
  studentId        String        @map("student_id")
  relationshipType String        @map("relationship_type")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  
  student          GlobalStudent @relation(fields: [studentId], references: [id])
  
  @@map("guardian_relationships")
}

model SeatIdentityForm {
  id                    String              @id @default(uuid())
  seatId                String              @unique @map("seat_id")
  status                SeatIdentityStatus  @default(draft)
  studentDisplayName    String              @map("student_display_name")
  studentEnglishName    String?             @map("student_english_name")
  birthDate             DateTime            @map("birth_date") @db.Date
  contactEmail          String              @map("contact_email")
  guardianEmail         String?             @map("guardian_email")
  contactPhone          String              @map("contact_phone")
  isMinor               Boolean             @map("is_minor")
  hasExternalInsurance  Boolean             @map("has_external_insurance")
  insuranceProvider     String?             @map("insurance_provider")
  note                  String?
  submittedAt           DateTime?           @map("submitted_at") @db.Timestamptz
  confirmedAt           DateTime?           @map("confirmed_at") @db.Timestamptz
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  
  seat                  OrderSeat           @relation(fields: [seatId], references: [id])
  
  @@map("seat_identity_forms")
}

model AbilityCatalog {
  id              Int        @id @default(autoincrement())
  name            String
  category        String
  sportType       SportType  @map("sport_type")
  skillLevel      Int        @map("skill_level")
  sequenceInLevel Int        @map("sequence_in_level")
  description     String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  
  @@map("ability_catalog")
}
